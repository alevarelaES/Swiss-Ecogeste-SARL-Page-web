{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/",
            "destination": "/fr",
            "permanent": false
        },
        {
            "source": "/:lng(fr|en|de)/services",
            "destination": "/:lng/services/villa",
            "permanent": false
        },
        {
            "source": "/:lng(fr|en|de)/resultats",
            "destination": "/:lng",
            "permanent": true
        },
        {
            "source": "/:page(a-propos|contact|actualites|mentions-legales|confidentialite|cookies)",
            "destination": "/fr/:page",
            "permanent": true
        },
        {
            "source": "/:section(services|actualites)/:slug",
            "destination": "/fr/:section/:slug",
            "permanent": true
        },
        {
            "source": "/home-2/:path*",
            "destination": "/fr",
            "permanent": true
        },
        {
            "source": "/feed/:path*",
            "destination": "/fr/actualites",
            "permanent": true
        },
        {
            "source": "/comments/feed/:path*",
            "destination": "/fr",
            "permanent": true
        },
        {
            "source": "/(wp-sitemap|sitemap_index|page-sitemap|post-sitemap).xml",
            "destination": "/sitemap.xml",
            "permanent": true
        },
        {
            "source": "/(wp-admin|wp-login.php|xmlrpc.php|wp-json)/:path*",
            "destination": "/fr",
            "permanent": true
        },
        {
            "source": "/(wp-admin|wp-login.php|xmlrpc.php|wp-json)",
            "destination": "/fr",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
